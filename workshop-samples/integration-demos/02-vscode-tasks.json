{
  // ===========================================================================
  // INTEGRATION DEMO #2: VS Code Tasks for Agentic QE + Claude Code agents
  //
  // Workshop: Quality Engineering in the Agentic Age
  // Phase: ORCHESTRATE
  //
  // Tasks 1-5 use the deterministic `aqe` CLI for fast checks.
  // Tasks 6-9 invoke specialist `@qe-...` agents through Claude Code for
  // judgment tasks (security review, test-quality audit, spec validation,
  // hallucinated-API detection).
  //
  // Save this file as .vscode/tasks.json. Run via:
  //   - Cmd/Ctrl+Shift+P → "Tasks: Run Task"
  //   - Keyboard shortcut bound in keybindings.json
  // ===========================================================================

  "version": "2.0.0",
  "tasks": [
    // -------------------------------------------------------------------------
    // 1. Coverage Gaps (Ghost Intent Coverage — phantom gap detection)
    // -------------------------------------------------------------------------
    {
      "label": "📊 AQE: Coverage Gaps (src/)",
      "type": "shell",
      "command": "aqe",
      "args": [
        "coverage",
        "--gaps",
        "--threshold", "80",
        "src/"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },

    // -------------------------------------------------------------------------
    // 2. Code Complexity on the active file
    // -------------------------------------------------------------------------
    {
      "label": "📈 AQE: Complexity (current file)",
      "type": "shell",
      "command": "aqe",
      "args": [
        "code", "complexity",
        "${file}"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },

    // -------------------------------------------------------------------------
    // 3. Dependency map for the project
    // -------------------------------------------------------------------------
    {
      "label": "🕸️ AQE: Dependencies (src/)",
      "type": "shell",
      "command": "aqe",
      "args": [
        "code", "deps",
        "src/"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },

    // -------------------------------------------------------------------------
    // 4. Quality gate (pass/fail verdict for the whole project)
    // -------------------------------------------------------------------------
    {
      "label": "✅ AQE: Quality Gate",
      "type": "shell",
      "command": "aqe",
      "args": [
        "quality",
        "--gate",
        "-F", "markdown",
        "-o", "${workspaceFolder}/.aqe-quality-gate.md"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },

    // -------------------------------------------------------------------------
    // 5. URL safety / PII check (prompts for URL)
    // -------------------------------------------------------------------------
    {
      "label": "🌐 AQE: Validate URL (security + PII)",
      "type": "shell",
      "command": "aqe",
      "args": [
        "security",
        "--url-validate", "${input:targetUrl}"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },

    // -------------------------------------------------------------------------
    // 6. @qe-security-scanner — review the active file
    // -------------------------------------------------------------------------
    {
      "label": "🛡️ Agent: Security Scanner (current file)",
      "type": "shell",
      "command": "claude",
      "args": [
        "-p",
        "@qe-security-scanner Review ${file}. Identify any authorization bypass, injection risk, hardcoded credentials, or other OWASP-class vulnerabilities. Quote the offending line(s), explain the impact, and propose a fix."
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },

    // -------------------------------------------------------------------------
    // 7. @qe-mutation-tester — audit the test file
    // -------------------------------------------------------------------------
    {
      "label": "🧪 Agent: Mutation Tester (current test file)",
      "type": "shell",
      "command": "claude",
      "args": [
        "-p",
        "@qe-mutation-tester Audit ${file}. Which tests pass but don't actually verify behavior? For each weak test, quote it, explain the gap, and propose a stronger assertion."
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },

    // -------------------------------------------------------------------------
    // 8. @qe-requirements-validator — check a spec/requirements doc
    // -------------------------------------------------------------------------
    {
      "label": "📋 Agent: Requirements Validator (current file)",
      "type": "shell",
      "command": "claude",
      "args": [
        "-p",
        "@qe-requirements-validator Read ${file}. List every contradiction, ambiguity, and numeric inconsistency. Quote each conflicting pair."
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },

    // -------------------------------------------------------------------------
    // 9. @qe-code-reviewer — general code review
    // -------------------------------------------------------------------------
    {
      "label": "🔍 Agent: Code Reviewer (current file)",
      "type": "shell",
      "command": "claude",
      "args": [
        "-p",
        "@qe-code-reviewer Review ${file}. Top 5 issues with line numbers. Cover correctness, security, performance, readability, and error handling. Be direct — quote the code, suggest the fix."
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },

    // -------------------------------------------------------------------------
    // COMPOUND TASK: pre-commit sweep (gates + complexity, no agent calls)
    // -------------------------------------------------------------------------
    {
      "label": "🚀 AQE: Pre-Commit Sweep",
      "dependsOn": [
        "📊 AQE: Coverage Gaps (src/)",
        "📈 AQE: Complexity (current file)",
        "✅ AQE: Quality Gate"
      ],
      "dependsOrder": "sequence",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ],

  "inputs": [
    {
      "id": "targetUrl",
      "type": "promptString",
      "description": "URL to validate for security threats / PII",
      "default": "https://example.com"
    }
  ]
}

// =============================================================================
// USAGE NOTES
// =============================================================================
//
// 1. Save this as .vscode/tasks.json in your project.
//
// 2. Prerequisites:
//    - `aqe init --auto --minimal` has been run at the project root once
//      (installs the @qe-... agents that tasks 6-9 invoke).
//    - `claude /login` has been completed.
//
// 3. Run tasks via:
//    - Cmd/Ctrl+Shift+P → "Tasks: Run Task"
//    - Keyboard shortcut (configure in keybindings.json):
//      {
//        "key": "cmd+shift+s",
//        "command": "workbench.action.tasks.runTask",
//        "args": "🛡️ Agent: Security Scanner (current file)"
//      }
//
// 4. For run-on-save with a deterministic AQE check, install
//    "Run on Save" (emeraldwalk.runonsave) and add to settings.json:
//      {
//        "emeraldwalk.runonsave": {
//          "commands": [
//            {
//              "match": "\\.(ts|js|tsx|jsx)$",
//              "cmd": "aqe code complexity ${file}"
//            }
//          ]
//        }
//      }
//    Don't run agent tasks on save — they cost tokens. Bind them to a
//    keyboard shortcut or run on demand.
//
// =============================================================================
// COMMANDS DELIBERATELY OMITTED
// =============================================================================
//
//   aqe security --sast       → use the @qe-security-scanner agent (task 6)
//   aqe test generate         → experimental; produces invalid identifiers
//                                from filenames containing hyphens or digits
//   aqe code search           → not yet returning meaningful results
//
// =============================================================================
// PACT ALIGNMENT
// =============================================================================
// Proactive    — pre-commit sweep blocks bad code before it reaches a PR
// Autonomous   — each task is one CLI call, scriptable everywhere
// Collaborative — Output panels + the .aqe-quality-gate.md report feed review
// Targeted     — ${file} keeps file-scoped tasks contextual; src/ keeps
//                whole-project tasks bounded
// =============================================================================
